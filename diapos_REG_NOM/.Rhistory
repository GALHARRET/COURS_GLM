riskratio(df$appelation,df$quality)
riskratio(df$appelation,df$quality,simulate.p.value=TRUE)
riskratio(df$appelation,df$quality)
riskratio(df$appelation,df$quality,correction = TRUE)
df$quality_bon<-factor(ifelse(df$quality == "bon", "bon", "autre"),
levels = c("autre", "bon"))
tab <- table(df$appelation, df$quality_bon)
riskratio(tab, method = "wald")
tab <- table(df$quality_bon,df$appelation)
riskratio(tab, method = "wald")
(sum(df$quality=="bon" & df$appelation=="AOP")/sum(df$appelation=="AOP"))/(sum(df$quality=="bon" & df$appelation=="non AOP")/sum(df$appelation=="non AOP"))
mod<-multinom(quality~appelation,data=df)
car::Anova(mod)
mod |>
tbl_regression(intercept=T)
df$quality=factor(df$quality,levels = c("mauvais","médiocre","moyen",
"bon","très bon","excellent"))
df%>%select(quality)%>%tbl_summary()
mod<-multinom(quality~appelation,data=df)
car::Anova(mod)
mod |>
tbl_regression(intercept=T)
predict(mod,newdata=data.frame("appelation"="non AOP"),
type="probs")
RR=predict(mod,newdata=data.frame("appelation"="non AOP"),
type="probs")/predict(mod,newdata=data.frame("appelation"="AOP"),
type="probs")
tab=data.frame(quality=names(RR),RR=RR)
tab |> gt()
