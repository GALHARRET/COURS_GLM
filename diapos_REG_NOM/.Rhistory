df=read.csv("data/winequality-red.csv",sep=";")
gt_preview(df)
df%>%select(quality,appelation)%>%tbl_cross()
df%>%select(quality,appelation)%>%tbl_cross(percent = "column")
(sum(df$quality=="bon" & df$appelation=="AOP")/sum(df$appelation=="AOP"))/(sum(df$quality=="bon" & df$appelation=="non AOP")/sum(df$appelation=="non AOP"))
(sum(df$quality=="bon" & df$appelation=="AOP")/sum(df$appelation=="AOP"))
(sum(df$quality=="bon" & df$appelation=="non AOP")/sum(df$appelation=="non AOP"))
install.packages("epitools")
